DB_HOST=localhost
DB_NAME=ContactManagerDB
DB_USER=ContactManagerUser
DB_PASSWORD=VeryStrongPass1!
DB_PORT=3306
DB_CHARSET=utf8mb4

# Session tokens lifetime
SESSION_TTL_DAYS=7

# Serve a 503 maintenance page while enabled
MAINTENANCE_MODE=false

# Restrict cross-origin requests to the front-end origin
CORS_ALLOWED_ORIGIN=http://localhost:8080

# Base URL of website.
APP_BASE_URL=http://localhost:8080

# How often to refresh GitHub data
GITHUB_REFRESH_HOURS=24

# Personal access token to raise GitHub API rate limits
GITHUB_TOKEN=

# GitHub OAuth app (for "Sign in with GitHub" / account linking)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/index.php/oauth/github/callback
