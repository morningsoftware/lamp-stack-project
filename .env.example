# Copy to .env and fill in real values. Never commit .env.
DB_HOST=localhost
DB_NAME=ContactManagerDB
DB_USER=ContactManagerUser
DB_PASSWORD=change-me
DB_PORT=3306
DB_CHARSET=utf8mb4

# Session tokens live this many days before expiring.
SESSION_TTL_DAYS=7

# Allowed CORS origin for the front-end (defaults to * when unset).
CORS_ALLOWED_ORIGIN=*

# Public base URL of the front-end, used to build password reset links.
APP_BASE_URL=http://localhost:8080

# Cached GitHub data is refreshed after this many hours.
GITHUB_REFRESH_HOURS=24

# Optional personal access token to raise GitHub API rate limits
# (strongly recommended: an unauthenticated sync is rate limited hard).
GITHUB_TOKEN=
