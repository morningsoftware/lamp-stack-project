DB_HOST=localhost
DB_NAME=ContactManagerDB
DB_USER=ContactManagerUser
DB_PASSWORD=password
DB_PORT=3306
DB_CHARSET=utf8mb4

# Session tokens lifetime
SESSION_TTL_DAYS=7

CORS_ALLOWED_ORIGIN=*

# Base URL of website.
APP_BASE_URL=http://localhost:8080

# How often to refresh GitHub data
GITHUB_REFRESH_HOURS=24

# Personal access token to raise GitHub API rate limits
GITHUB_TOKEN=
