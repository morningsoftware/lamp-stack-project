# Copy to .env and fill in real values. Never commit .env.
DB_HOST=localhost
DB_NAME=developer_bio_site
DB_USER=bioapp_user
DB_PASSWORD=change-me
DB_PORT=3306
DB_CHARSET=utf8mb4

# Session tokens live this many days before expiring.
SESSION_TTL_DAYS=7

# Allowed CORS origin for the front-end (defaults to * when unset).
CORS_ALLOWED_ORIGIN=*

# Optional personal access token to raise GitHub API rate limits.
GITHUB_TOKEN=
